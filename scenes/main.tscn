[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/dungeon.gd" id="1_dungeon"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="2_player"]
[ext_resource type="Script" path="res://scripts/hud.gd" id="3_hud"]

[node name="Main" type="Node2D"]
script = ExtResource("1_dungeon")

[node name="Map" type="TileMapLayer" parent="."]

[node name="Ground" type="Node2D" parent="."]

[node name="Entities" type="Node2D" parent="."]
y_sort_enabled = true

[node name="Player" parent="Entities" instance=ExtResource("2_player")]

[node name="FX" type="Node2D" parent="."]

[node name="HUD" type="CanvasLayer" parent="."]
script = ExtResource("3_hud")
