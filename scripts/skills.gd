extends RefCounted
## Классы, профессии и навыки — только данные. Как навыки работают — в scripts/player.gd
## (_cast_<id> — мгновенные, _release_<id> — после каста, _tick_<id> — тики канала).
##
## Как в Ragnarok: забег начинается базовым классом (Мечник/Лучник/Маг), на уровне
## JOB_LEVEL выбирается одна из двух профессий. При смене профессии очки навыков
## возвращаются, у профессии свои 3 активных навыка (клавиши 1–3) и пассивный.
##
## Значения навыков: "v"/"v2" — [на 1-м уровне, прибавка за уровень];
## "v_t"/"v2_t" — таблица значений по уровням (если рост не ровный).
## В описании {v} и {v2} заменяются числами для нужного уровня.
## "cast" — время каста (с), "cast_min" — меньше этого не ускорить.

const MAX_LEVEL := 5
const MIN_CAST := 0.3  # общий нижний предел, чтобы каст не стал мгновенным
const JOB_LEVEL := 5   # на каком уровне героя выбирается профессия


## Время каста с учётом скорости каста (%). 0 — навык мгновенный.
static func cast_time(id: String, cast_speed: float) -> float:
	var s: Dictionary = SKILLS[id]
	var base: float = s.get("cast", 0.0)
	if base <= 0.0:
		return 0.0
	return maxf(s.get("cast_min", MIN_CAST), base / (1.0 + cast_speed / 100.0))


