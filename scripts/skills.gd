static func value(id: String, level: int, key := "v") -> float:
	var s: Dictionary = SKILLS[id]
	var lv := clampi(level, 1, MAX_LEVEL)
	if s.has(key + "_t"):
		return s[key + "_t"][lv - 1]
	if not s.has(key):
		return 0.0
	return s[key][0] + s[key][1] * (lv - 1)


static func sp_cost(id: String, level: int) -> int:
	var s: Dictionary = SKILLS[id]
	if not s.has("sp"):
		return 0
	return int(s["sp"][0] + s["sp"][1] * (maxi(level, 1) - 1))


static func describe(id: String, level: int) -> String:
	var v := value(id, level)
	var v2 := value(id, level, "v2")
	return (SKILLS[id]["desc"] as String).format({"v": _num(v), "v2": _num(v2)})


static func _num(x: float) -> String:
	return str(int(x)) if is_equal_approx(x, roundf(x)) else "%.1f" % x


## Список навыков: профессии, если выбрана, иначе базового класса.
static func skills_for(cls: String, job: String) -> Array:
	if job != "":
		return JOBS[job]["skills"]
	return CLASSES[cls if cls != "" else "warrior"]["skills"]


## Активные навыки по порядку (клавиши 1, 2, 3).
static func actives_of(list: Array) -> Array:
	var out := []
	for id: String in list:
		if SKILLS[id]["type"] == "active":
			out.append(id)
	return out
